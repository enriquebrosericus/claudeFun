FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir "flask>=3.0" "psycopg2-binary>=2.9" "gunicorn>=21.0"

# The alternate frontend ("The Mariner's Almanac"). Single source shared with
# local dev (dev/docker-compose.yml bind-mounts the same dir).
COPY dev/frontend/ ./

CMD ["gunicorn", "-w", "2", "-b", "0.0.0.0:8080", "--timeout", "30", "server:app"]
